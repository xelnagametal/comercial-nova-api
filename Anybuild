# Anybuild build definition for Wasmer — https://anybuild.run
# Mirrors the auto-detected Laravel config, with PHP pinned to 8.5:
# the locked dependencies (Symfony 8, Pest 5, PHPUnit 13) require PHP >= 8.4.1,
# while Anybuild's default is 8.3.29.

load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config", "laravel_serve")

config = laravel_config(
    schema = 1,
    # `--force`: without it `migrate` asks for confirmation in production and
    # cancels itself (exit 1) because the deploy hook has no interactive terminal.
    # The hook is not run through a shell (`&&` reaches artisan as an argument), so
    # seeding uses migrate's own `--seed --seeder`. RolesYPermisosSeeder is idempotent:
    # it creates the permissions added to the enums and gives them all to the administrador.
    commands = {"after_deploy": "php artisan migrate --force --seed --seeder=RolesYPermisosSeeder"},
    node_package_manager = "npm",
    node_version = "24",
    npm_version = "11",
    php_framework = "laravel",
    composer_enable = True,
    # Not "post-update-cmd": it runs `boost:update`, a dev-only command that
    # Laravel Boost does not register outside the local environment.
    composer_build_script = "wasmer-build",
    php_version = "8.5",
    php_public_dir = "public",
)

build = laravel_build(config)

laravel_serve(config, build)
